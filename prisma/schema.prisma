generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  ADMIN
  EMPLOYEE
}

enum UserStatus {
  ACTIVE
  RESTRICTED
}

enum ProductStatus {
  PUBLISHED
  DRAFT
  ARCHIVED
}

enum ProductType {
  FULL_APPLICATION
  TEMPLATE
  RESOURCE
  PLUGIN
}

enum CategoryStatus {
  ACTIVE
  INACTIVE
}

enum OrderStatus {
  PENDING
  COMING_SOON
  COMPLETED
  CANCELLED
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
}

enum PreviewStatus {
  NONE
  PENDING
  BUILDING
  READY
  FAILED
  DISABLED
  REQUIRES_INFRASTRUCTURE
}

enum PreviewType {
  STATIC_HTML
  REACT_VITE
  FULLSTACK
  UNKNOWN
}

model User {
  id           String         @id @default(uuid())
  name         String
  email        String         @unique
  passwordHash String
  role         Role           @default(CUSTOMER)
  status       UserStatus     @default(ACTIVE)
  avatar       String?
  phone        String?
  company      String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  orders          Order[]
  downloads       Download[]
  supportTickets  SupportTicket[]
  supportMessages SupportMessage[]

  employeeProfile EmployeeProfile?
  notifications   Notification[]
  auditLogs       AuditLog[]
  reviewedSubmissions SkillTaskSubmission[] @relation("SubmissionReviewer")

  @@map("users")
}

model Category {
  id          String         @id @default(uuid())
  name        String
  slug        String         @unique
  description String?
  icon        String?
  status      CategoryStatus @default(ACTIVE)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  products Product[]

  @@map("categories")
}

model Technology {
  id        String   @id @default(uuid())
  name      String   @unique
  slug      String   @unique
  icon      String?
  createdAt DateTime @default(now())

  products ProductTechnology[]

  @@map("technologies")
}

model Product {
  id                       String         @id @default(uuid())
  title                    String
  slug                     String         @unique
  shortDescription         String
  fullDescription          String
  categoryId               String
  thumbnail                String?
  demoUrl                  String?
  previewUrl               String?
  previewStatus            PreviewStatus  @default(NONE)
  previewType              PreviewType?
  previewBuildLogs         String?        @db.Text
  previewUpdatedAt         DateTime?
  productType              ProductType    @default(FULL_APPLICATION)
  price                    Decimal        @default(0.00) @db.Decimal(10, 2)
  isFree                   Boolean        @default(false)
  viewPrice                Decimal        @default(0.00) @db.Decimal(10, 2)
  isViewFree               Boolean        @default(true)
  isFeatured               Boolean        @default(false)
  status                   ProductStatus  @default(PUBLISHED)
  licenseText              String?
  supportInformation       String?
  installationRequirements String?
  deliverables             String?
  documentationAvailable   Boolean        @default(true)
  downloadAllowed          Boolean        @default(false)
  viewCount                Int            @default(0)
  createdAt                DateTime       @default(now())
  updatedAt                DateTime       @updatedAt

  category       Category             @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  images         ProductImage[]
  technologies   ProductTechnology[]
  files          ProductFile[]
  orderItems     OrderItem[]
  downloads      Download[]
  supportTickets SupportTicket[]

  @@map("products")
}

model ProductImage {
  id           String   @id @default(uuid())
  productId    String
  imageUrl     String
  altText      String?
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("product_images")
}

model ProductTechnology {
  productId    String
  technologyId String

  product    Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  technology Technology @relation(fields: [technologyId], references: [id], onDelete: Cascade)

  @@id([productId, technologyId])
  @@map("product_technologies")
}

model ProductFile {
  id                 String   @id @default(uuid())
  productId          String
  filename           String
  originalName       String
  privateStorageKey  String
  fileSize           BigInt
  fileType           String
  version            String   @default("1.0.0")
  createdAt          DateTime @default(now())

  product   Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  downloads Download[]

  @@map("product_files")
}

model Order {
  id          String      @id @default(uuid())
  orderNumber String      @unique
  userId      String
  status      OrderStatus @default(COMING_SOON)
  totalAmount Decimal     @default(0.00) @db.Decimal(10, 2)
  notes       String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  user  User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  items OrderItem[]

  @@map("orders")
}

model OrderItem {
  id        String   @id @default(uuid())
  orderId   String
  productId String
  price     Decimal  @db.Decimal(10, 2)

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@map("order_items")
}

model Download {
  id            String   @id @default(uuid())
  userId        String
  productId     String
  productFileId String
  ipAddress     String?
  userAgent     String?
  downloadedAt  DateTime @default(now())

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  product     Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  productFile ProductFile @relation(fields: [productFileId], references: [id], onDelete: Cascade)

  @@map("downloads")
}

model SupportTicket {
  id           String         @id @default(uuid())
  ticketNumber String         @unique
  userId       String
  productId    String?
  subject      String
  message      String
  status       TicketStatus   @default(OPEN)
  priority     TicketPriority @default(MEDIUM)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  product  Product?         @relation(fields: [productId], references: [id], onDelete: SetNull)
  messages SupportMessage[]

  @@map("support_tickets")
}

model SupportMessage {
  id        String   @id @default(uuid())
  ticketId  String
  userId    String
  message   String
  isAdmin   Boolean  @default(false)
  createdAt DateTime @default(now())

  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  user   User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("support_messages")
}

model WebsiteSetting {
  id          String   @id @default(uuid())
  key         String   @unique
  value       String
  description String?
  updatedAt   DateTime @updatedAt

  @@map("website_settings")
}

model EmployeeProfile {
  id           String              @id @default(uuid())
  userId       String              @unique
  employeeId   String              @unique
  department   String
  designation  String
  primarySkill String
  joiningDate  DateTime            @default(now())
  status       String              @default("ACTIVE")
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  skills       EmployeeSkill[]
  assignments  ProjectAssignment[]
  tasks        ProjectTask[]
  skillTracks      EmployeeSkillTrack[]
  skillProgress    EmployeeSkillProgress[]
  taskSubmissions  SkillTaskSubmission[]

  @@map("employee_profiles")
}

model EmployeeSkill {
  id                String          @id @default(uuid())
  employeeProfileId String
  skillName         String
  proficiency       String?         @default("Intermediate")
  verified          Boolean         @default(true)
  createdAt         DateTime        @default(now())

  employeeProfile   EmployeeProfile @relation(fields: [employeeProfileId], references: [id], onDelete: Cascade)

  @@map("employee_skills")
}

model Project {
  id                     String               @id @default(uuid())
  title                  String
  description            String               @db.Text
  projectType            String
  primarySkill           String
  framework              String?
  database               String?
  frontend               String?
  difficulty             String               @default("Medium")
  priority               String               @default("Medium")
  startDate              DateTime?
  dueDate                DateTime?
  objective              String?              @db.Text
  technicalRequirements String?              @db.Text
  additionalRequirements String?              @db.Text
  referenceFiles         Json?
  submissionRequirements Json?
  executionConfig        Json?
  status                 String               @default("ASSIGNED")
  progress               Int                  @default(0)
  createdById            String?
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt

  assignments            ProjectAssignment[]
  requirements           ProjectRequirement[]
  submissions            ProjectSubmission[]
  tasks                  ProjectTask[]

  @@map("managed_projects")
}

model ProjectAssignment {
  id                String          @id @default(uuid())
  projectId         String
  employeeProfileId String
  assignedAt        DateTime        @default(now())
  status            String          @default("ASSIGNED")
  score             Int?
  startedAt         DateTime?
  completedAt       DateTime?

  project           Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  employeeProfile   EmployeeProfile @relation(fields: [employeeProfileId], references: [id], onDelete: Cascade)

  @@unique([projectId, employeeProfileId])
  @@map("project_assignments")
}

model ProjectRequirement {
  id          String   @id @default(uuid())
  projectId   String
  title       String
  description String?
  isCompleted Boolean  @default(false)

  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("project_requirements")
}

model ProjectSubmission {
  id                String            @id @default(uuid())
  projectId         String
  employeeProfileId String
  currentVersion    Int               @default(1)
  status            String            @default("SUBMITTED")
  submittedAt       DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  project           Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  versions          ProjectVersion[]
  feedbacks         ProjectFeedback[]

  @@map("project_submissions")
}

model ProjectVersion {
  id               String             @id @default(uuid())
  submissionId     String
  versionNumber    Int
  filePath         String?
  fileName         String?
  fileSize         BigInt?
  githubUrl        String?
  liveDemoUrl      String?
  readmeContent    String?            @db.Text
  screenshots      Json?
  documentation    String?            @db.Text
  notes            String?            @db.Text
  validationStatus String             @default("VALID")
  validationReport Json?
  createdAt        DateTime           @default(now())

  submission       ProjectSubmission  @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  executions       ProjectExecution[]
  feedbacks        ProjectFeedback[]

  @@map("project_versions")
}

model ProjectExecution {
  id           String              @id @default(uuid())
  versionId    String
  status       String              @default("PENDING")
  buildStatus  String?
  testStatus   String?
  exitCode     Int?
  runtimeMs    Int?
  consoleLogs  String?             @db.Text
  output       String?             @db.Text
  errors       String?             @db.Text
  warnings     String?             @db.Text
  sandboxPath  String?
  executedById String?
  createdAt    DateTime            @default(now())
  completedAt  DateTime?

  version      ProjectVersion      @relation(fields: [versionId], references: [id], onDelete: Cascade)
  testResults  ProjectTestResult[]

  @@map("project_executions")
}

model ProjectTestResult {
  id          String           @id @default(uuid())
  executionId String
  testName    String
  status      String
  durationMs  Int?
  message     String?
  details     String?          @db.Text

  execution   ProjectExecution @relation(fields: [executionId], references: [id], onDelete: Cascade)

  @@map("project_test_results")
}

model ProjectFeedback {
  id                 String             @id @default(uuid())
  submissionId       String
  versionId          String?
  reviewerId         String
  status             String
  comments           String?            @db.Text
  technicalFeedback  String?            @db.Text
  requiredChanges    String?            @db.Text
  testingFeedback    String?            @db.Text
  revisionDeadline   DateTime?
  rejectionReason    String?            @db.Text
  scoreCodeQuality   Int?
  scoreFunctionality Int?
  scoreUiUx          Int?
  scoreDatabase      Int?
  scoreTesting       Int?
  scoreDocumentation Int?
  scorePerformance   Int?
  scoreSecurity      Int?
  overallScore       Int?
  createdAt          DateTime           @default(now())

  submission         ProjectSubmission  @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  version            ProjectVersion?    @relation(fields: [versionId], references: [id], onDelete: SetNull)

  @@map("project_feedbacks")
}

model ProjectTask {
  id                String          @id @default(uuid())
  projectId         String
  employeeProfileId String
  title             String
  description       String?         @db.Text
  priority          String          @default("Medium")
  startDate         DateTime?
  dueDate           DateTime?
  status            String          @default("Pending")
  createdById       String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  project           Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  employeeProfile   EmployeeProfile @relation(fields: [employeeProfileId], references: [id], onDelete: Cascade)

  @@map("project_tasks")
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  title     String
  message   String   @db.Text
  type      String
  link      String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  action    String
  entity    String
  entityId  String?
  details   Json?
  ipAddress String?
  createdAt DateTime @default(now())

  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("audit_logs")
}

// ─── SKILL-BASED TASK & CURRICULUM MANAGEMENT SYSTEM ─────────────────────────

enum TaskLevel {
  BASIC
  INTERMEDIATE
  ADVANCED
}

enum TaskDifficulty {
  EASY
  MEDIUM
  HARD
}

enum TaskStatus {
  ACTIVE
  INACTIVE
}

enum SubmissionStatus {
  PENDING_REVIEW
  APPROVED
  REJECTED
}

model Skill {
  id          String   @id @default(uuid())
  name        String   @unique
  slug        String   @unique
  description String?  @db.Text
  icon        String?
  status      String   @default("ACTIVE")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tasks          SkillTask[]
  employeeTracks EmployeeSkillTrack[]
  progress       EmployeeSkillProgress[]

  @@map("curriculum_skills")
}

model EmployeeSkillTrack {
  id                String          @id @default(uuid())
  employeeProfileId String
  skillId           String
  assignedAt        DateTime        @default(now())

  employeeProfile   EmployeeProfile @relation(fields: [employeeProfileId], references: [id], onDelete: Cascade)
  skill             Skill           @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([employeeProfileId, skillId])
  @@map("employee_skill_tracks")
}

model EmployeeSkillProgress {
  id                     String          @id @default(uuid())
  employeeProfileId      String
  skillId                String
  unlockedLevel          TaskLevel       @default(BASIC)
  basicCompleted         Boolean         @default(false)
  intermediateCompleted  Boolean         @default(false)
  advancedCompleted      Boolean         @default(false)
  completedAt            DateTime?
  updatedAt              DateTime        @updatedAt

  employeeProfile        EmployeeProfile @relation(fields: [employeeProfileId], references: [id], onDelete: Cascade)
  skill                  Skill           @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([employeeProfileId, skillId])
  @@map("employee_skill_progress")
}

model SkillTask {
  id             String          @id @default(uuid())
  skillId        String
  level          TaskLevel       @default(BASIC)
  title          String
  description    String          @db.Text
  instructions   String          @db.Text
  expectedOutput String?         @db.Text
  difficulty     TaskDifficulty  @default(EASY)
  githubRepoUrl  String?
  githubBranch   String?         @default("main")
  status         TaskStatus      @default(ACTIVE)
  initialCode    String?         @db.Text
  isRequired     Boolean         @default(true)
  orderIndex     Int             @default(1)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  skill          Skill           @relation(fields: [skillId], references: [id], onDelete: Cascade)
  submissions    SkillTaskSubmission[]

  @@map("skill_tasks")
}

model SkillTaskSubmission {
  id                String           @id @default(uuid())
  taskId            String
  employeeProfileId String
  submittedCode     String?          @db.Text
  projectFiles      Json?
  githubRepoUrl     String?
  executionOutput   String?          @db.Text
  executionError    String?          @db.Text
  executionTimeMs   Int?
  status            SubmissionStatus @default(PENDING_REVIEW)
  adminComment      String?          @db.Text
  reviewedById      String?
  reviewedAt        DateTime?
  submittedAt       DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  task              SkillTask        @relation(fields: [taskId], references: [id], onDelete: Cascade)
  employeeProfile   EmployeeProfile  @relation(fields: [employeeProfileId], references: [id], onDelete: Cascade)
  reviewer          User?            @relation("SubmissionReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@map("skill_task_submissions")
}

