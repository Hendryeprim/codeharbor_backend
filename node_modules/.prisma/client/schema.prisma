generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  ADMIN
}

enum UserStatus {
  ACTIVE
  RESTRICTED
}

enum ProductStatus {
  PUBLISHED
  DRAFT
  ARCHIVED
}

enum ProductType {
  FULL_APPLICATION
  TEMPLATE
  RESOURCE
  PLUGIN
}

enum CategoryStatus {
  ACTIVE
  INACTIVE
}

enum OrderStatus {
  PENDING
  COMING_SOON
  COMPLETED
  CANCELLED
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
}

model User {
  id           String     @id @default(uuid())
  name         String
  email        String     @unique
  passwordHash String
  role         Role       @default(CUSTOMER)
  status       UserStatus @default(ACTIVE)
  avatar       String?
  phone        String?
  company      String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  orders          Order[]
  downloads       Download[]
  supportTickets  SupportTicket[]
  supportMessages SupportMessage[]

  @@map("users")
}

model Category {
  id          String         @id @default(uuid())
  name        String
  slug        String         @unique
  description String?
  icon        String?
  status      CategoryStatus @default(ACTIVE)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  products Product[]

  @@map("categories")
}

model Technology {
  id        String   @id @default(uuid())
  name      String   @unique
  slug      String   @unique
  icon      String?
  createdAt DateTime @default(now())

  products ProductTechnology[]

  @@map("technologies")
}

model Product {
  id                       String        @id @default(uuid())
  title                    String
  slug                     String        @unique
  shortDescription         String
  fullDescription          String
  categoryId               String
  thumbnail                String?
  demoUrl                  String?
  productType              ProductType   @default(FULL_APPLICATION)
  price                    Decimal       @default(0.00) @db.Decimal(10, 2)
  isFree                   Boolean       @default(false)
  isFeatured               Boolean       @default(false)
  status                   ProductStatus @default(PUBLISHED)
  licenseText              String?
  supportInformation       String?
  installationRequirements String?
  deliverables             String?
  documentationAvailable   Boolean       @default(true)
  downloadAllowed          Boolean       @default(false)
  viewCount                Int           @default(0)
  createdAt                DateTime      @default(now())
  updatedAt                DateTime      @updatedAt

  category       Category            @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  images         ProductImage[]
  technologies   ProductTechnology[]
  files          ProductFile[]
  orderItems     OrderItem[]
  downloads      Download[]
  supportTickets SupportTicket[]

  @@map("products")
}

model ProductImage {
  id           String   @id @default(uuid())
  productId    String
  imageUrl     String
  altText      String?
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("product_images")
}

model ProductTechnology {
  productId    String
  technologyId String

  product    Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  technology Technology @relation(fields: [technologyId], references: [id], onDelete: Cascade)

  @@id([productId, technologyId])
  @@map("product_technologies")
}

model ProductFile {
  id                String   @id @default(uuid())
  productId         String
  filename          String
  originalName      String
  privateStorageKey String
  fileSize          BigInt
  fileType          String
  version           String   @default("1.0.0")
  createdAt         DateTime @default(now())

  product   Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  downloads Download[]

  @@map("product_files")
}

model Order {
  id          String      @id @default(uuid())
  orderNumber String      @unique
  userId      String
  status      OrderStatus @default(COMING_SOON)
  totalAmount Decimal     @default(0.00) @db.Decimal(10, 2)
  notes       String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  user  User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  items OrderItem[]

  @@map("orders")
}

model OrderItem {
  id        String  @id @default(uuid())
  orderId   String
  productId String
  price     Decimal @db.Decimal(10, 2)

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@map("order_items")
}

model Download {
  id            String   @id @default(uuid())
  userId        String
  productId     String
  productFileId String
  ipAddress     String?
  userAgent     String?
  downloadedAt  DateTime @default(now())

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  product     Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  productFile ProductFile @relation(fields: [productFileId], references: [id], onDelete: Cascade)

  @@map("downloads")
}

model SupportTicket {
  id           String         @id @default(uuid())
  ticketNumber String         @unique
  userId       String
  productId    String?
  subject      String
  message      String
  status       TicketStatus   @default(OPEN)
  priority     TicketPriority @default(MEDIUM)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  product  Product?         @relation(fields: [productId], references: [id], onDelete: SetNull)
  messages SupportMessage[]

  @@map("support_tickets")
}

model SupportMessage {
  id        String   @id @default(uuid())
  ticketId  String
  userId    String
  message   String
  isAdmin   Boolean  @default(false)
  createdAt DateTime @default(now())

  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  user   User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("support_messages")
}

model WebsiteSetting {
  id          String   @id @default(uuid())
  key         String   @unique
  value       String
  description String?
  updatedAt   DateTime @updatedAt

  @@map("website_settings")
}
